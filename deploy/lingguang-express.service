[Unit]
Description=LingGuang Express API
After=network.target mysql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/lingguang-express
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5
Environment=HOME=/tmp/lingguang
Environment=NODE_ENV=production
MemoryMax=300M
OOMScoreAdjust=300

[Install]
WantedBy=multi-user.target
